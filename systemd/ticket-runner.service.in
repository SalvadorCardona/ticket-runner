[Unit]
Description=ticket-runner — one pass over the Notion tickets
Documentation=https://github.com/SalvadorCardona/ticket-runner
After=network-online.target

[Service]
Type=oneshot
ExecStart=@BIN@ run

# A Claude session takes as long as it takes; the runner is what bounds it
# (runner.timeout_minutes), not systemd, which would kill it mid-commit.
TimeoutStartSec=infinity

# A service's PATH is not a login shell's: without this line, neither claude,
# nor gh, nor node would be found.
Environment=PATH=@PATH@
Environment=PYTHONUNBUFFERED=1
