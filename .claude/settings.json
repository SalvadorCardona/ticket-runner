{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 scripts/release.py current)",
      "Bash(python3 scripts/release.py notes:*)",
      "Bash(python3 scripts/release.py check:*)",
      "Bash(python3 tests/run.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git describe:*)",
      "Bash(git tag --list:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)"
    ]
  }
}
