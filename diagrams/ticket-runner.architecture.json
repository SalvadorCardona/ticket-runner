  "cards": [
    {
      "dot": "cyan",
      "title": "The one rule",
      "items": [
        "A ticket is never worked on in the main repository",
        "One disposable worktree per ticket, on its own branch",
        "The agent commits; the runner pushes and opens the pull request"
      ]
    },
    {
      "dot": "violet",
      "title": "The board decides",
      "items": [
        "Ready is the gesture that starts work",
        "Validated is the gesture that finishes it: merge, or publish",
        "A project with a repository produces code; one without produces a document"
      ]
    },
    {
      "dot": "emerald",
      "title": "What never leaves the machine",
      "items": [
        "Sessions, logs and the run lock live under ~/.local/state",
        "The console binds to loopback unless a token says otherwise",
        "Only Notion, GitHub and your chosen channel are reached outward"
      ]
    }
